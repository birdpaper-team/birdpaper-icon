{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "module": "Node16",
    "target": "ES2020",
    "allowJs": true,
    "moduleResolution": "Node16",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"]
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
