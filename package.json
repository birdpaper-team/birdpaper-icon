{
  "version": "1.0.0",
  "description": "BirdpaperIcon Workspaces",
  "scripts": {
    "docs:dev": "pnpm run -C docs dev",
    "docs:build": "pnpm run -C docs build",
    "docs:build:root": "pnpm run -C docs build:root",
    "docs:preview": "pnpm run -C docs preview",
    "generate": "pnpm run -C packages/components generate",
    "scripts:dev": "pnpm run -C scripts/generate dev",
    "scripts:build": "pnpm run -C scripts/generate build",
    "clean": "rimraf dist && pnpm run -r --parallel clean",
    "build": "pnpm run clean && pnpm run -C scripts/build start"
  },
  "dependencies": {
    "@birdpaper-icon/components": "workspace:*",
    "@birdpaper-icon/theme": "workspace:*",
    "@vueuse/components": "^11.1.0",
    "@vueuse/core": "^10.11.0",
    "radash": "^12.1.0",
    "birdpaper-ui": "^3.0.0-alpha.32"
  },
  "devDependencies": {
    "@pnpm/find-workspace-packages": "^4.0.16",
    "@pnpm/types": "^8.4.0",
    "@types/fs-extra": "^9.0.13",
    "@types/node": "^18.19.25",
    "@unocss/reset": "^0.61.7",
    "@vitejs/plugin-vue": "^5.1.3",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "1.6.0",
    "@vue/test-utils": "^2.0.0",
    "@vue/tsconfig": "^0.1.3",
    "gulp-autoprefixer": "^9.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "oxlint": "^0.6.1",
    "rimraf": "^3.0.2",
    "prettier": "^2.7.1",
    "vite": "^5.3.5",
    "vue": "^3.5.3",
    "sass": "^1.77.8",
    "tsx": "^4.7.1",
    "typescript": "^4.7.4",
    "unocss": "^0.61.7",
    "unplugin-vue-macros": "^2.7.11",
    "vitest": "1.6.0"
  },
  "keywords": [
    "Remix icon",
    "icon-components",
    "svg-components",
    "Vue3"
  ],
  "author": "木亦Sam",
  "license": "MIT",
  "main": "es/index.js",
  "module": "es/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": [
    "dist/*",
    "es/**/style/*",
    "lib/**/style/*",
    "*.less"
  ],
  "files": [
    "dist",
    "es",
    "lib"
  ],
  "homepage": "https://www.birdpaper.design/guide/icon",
  "repository": {
    "type": "git",
    "url": "https://github.com/birdpaper-team/birdpaper-icon"
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,md,json}": "oxlint --fix"
  }
}
