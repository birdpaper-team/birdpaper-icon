{
  "compilerOptions": {
    "jsx": "preserve",
    "outDir": "dist",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "sourceMap": false,
    "noImplicitAny": false,
    "allowJs": false,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "removeComments": false,
    "lib": ["DOM", "ES2020"],
    "rootDir": ".",
    "paths": {
      "@birdpaper-icon/*": ["packages/*"]
    }
  },
  "include": [
    "packages/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/*.js"]
}
