{
  "compilerOptions": {
   
    "jsx": "react",
    "jsxFactory": "h",
    "outDir": "dist",
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "sourceMap": false,
    "noImplicitAny": false,
    "allowJs": false,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "removeComments": false,
    "lib": ["DOM", "ES2020"],
    "rootDir": ".",
    "typeRoots": ["./node_modules/@types/", "./docs/types"],
  },
  "paths": {
    "@birdpaper-icon/*": ["packages/*"]
  },
  "include": [
    "packages/birdpaper-icon/**/*.ts",
    "packages/birdpaper-icon/**/*.d.ts",
    "packages/birdpaper-icon/**/*.tsx",
    "packages/birdpaper-icon/**/*.vue",
    "packages/components/**/*.ts",
    "packages/components/**/*.d.ts",
    "packages/components/**/*.tsx",
    "packages/components/**/*.vue",
    "docs/**/*.ts",
    "docs/**/*.d.ts",
    "docs/**/*.tsx",
    "docs/**/*.vue",
    "docs/src/types/svg.d.ts",
    "docs/src/.vitepress/components/home/svg.d.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.js"]
}
